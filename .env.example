# ==============================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ==============================================
POSTGRES_USER=user_intranet
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=intranet_db

# ==============================================
# CONFIGURACIÓN DEL BACKEND (API)
# ==============================================
NODE_ENV=development
DB_HOST=db
DB_PORT=5432
DB_USER=user_intranet
DB_PASSWORD=strong_password
DB_NAME=intranet_db

# Puerto de la API (interno del contenedor)
PORT=3001

# ==============================================
# NOTAS IMPORTANTES
# ==============================================
# 1. Este archivo es un EJEMPLO. NO contiene credenciales reales.
# 2. Para desarrollo local, estas variables están en docker-compose.yml
# 3. Para producción, crea un archivo .env con valores seguros
# 4. NUNCA subas el archivo .env real a Git (está en .gitignore)
# 5. Cambia POSTGRES_PASSWORD por una contraseña segura en producción
